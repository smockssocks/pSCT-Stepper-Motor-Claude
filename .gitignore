__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.coverage
htmlcov/

# The live machine configuration: calibration, zero points and IP addresses
# belong to a particular telescope, not to the repository. The committed
# example under config/psct_motors.example.json is the template.
config/psct_motors.json
config/*.tmp

# Event log recordings from `cli watch` and the bench GUI.
logs/

# Where the focal plane has been: written by the application, one line per
# move, beside the configuration. Belongs to the machine, not the repository.
config/positions.jsonl
